    "innovation": "This paper provides a comprehensive overview of theoretical, modeling, laboratory, and field research on the role of ions in tropospheric new particle formation, its subsequent effects on clouds, and its connection to the solar cycle via galactic cosmic rays.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "International Satellite Cloud Climatology Project (ISCCP)",
            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "global cloud cover",
            "target_entity_type": "Variable",
            "paragraph": "A corresponding correlation was first reported by Svensmark and Friis-Christensen (1997), who found a 3\u20134% variation of the global cloud cover over a solar cycle based on data of the International Satellite Cloud Climatology Project (ISCCP) (Rossow and Schiffer 1991) for the years 1983\u20131992.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Raes and Janssens (1985, 1986) model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "classical neutral and charged nucleation",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "In an early combined modeling/experimental study, Raes and Janssens (1985, 1986) investigated neutral and charged nucleation in a mixture of gaseous sulfuric acid and water, using a model of classical neutral and charged nucleation.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Laakso et al. (2002) model",
            "source_entity_type": "Source",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "aerosol",
            "target_entity_type": "Realm",
            "paragraph": "Laakso et al. (2002) developed a model of neutral, negative, and positive H2SO4/H2O aerosol which accounts, above a certain size, for multiply charged particles.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Lovejoy et al. (2004) model",
            "source_entity_type": "Source",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "aerosol",
            "target_entity_type": "Realm",
            "paragraph": "Lovejoy et al. (2004) developed a detailed aerosol model of neutral and negative H2SO4/H2O aerosol particles.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Lovejoy et al. (2004) model",
            "source_entity_type": "Source",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "atmos",
            "target_entity_type": "Realm",
            "paragraph": "The model predicts that charged nucleation of H2SO4 and H2O proceeds efficiently in the middle and upper troposphere, and explained nucleation events observed in the remote middle troposphere with the charged H2SO4/H2O mechanism, but not generally nucleation events observed in the boundary layer (Lovejoy et al. 2004).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Lovejoy et al. (2004) model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "liquid drop model",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The modeling approaches discussed so far employed thermochemical parameters for the formation of neutral and charged molecular clusters that were derived from classical nucleation theory. Lovejoy et al. (2004) developed a detailed aerosol model of neutral and negative H2SO4/H2O aerosol particles. Small neutral and negative H2SO4/H2O clusters are resolved individually, and larger particles with geometric bins. Laboratory thermochemical parameters measured by Curtius et al. (2001) and Froyd and Lovejoy (2003b) for the small negative H2SO4/H2O clusters were used. Thermochemical parameters for small neutral H2SO4/H2O clusters were obtained from the liquid drop model, adjusted to reproduce the laboratory measurements of Ball et al. (1999).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Lovejoy et al. (2004) model",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "individual resolution of small clusters and geometric bins for larger particles",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "Lovejoy et al. (2004) developed a detailed aerosol model of neutral and negative H2SO4/H2O aerosol particles. Small neutral and negative H2SO4/H2O clusters are resolved individually, and larger particles with geometric bins.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Yu (2007) model",
            "source_entity_type": "Source",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "aerosol",
            "target_entity_type": "Realm",
            "paragraph": "Yu (2007) developed a detailed model of positive, negative, and neutral H2SO4/H2O aerosol particles, forming by neutral and charged nucleation of sulfuric acid and water, and growing by uptake of these compounds as well as by condensation of organic molecules.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Yu (2007) model",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "individual resolution of small clusters and geometric bins for larger particles",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "The model resolves the small H2SO4/H2O clusters individually, and larger particles with geometric bins.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Yu et al. (2008) chemical transport model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "nucleation rates from the model of Yu (2007)",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Most recently, Yu et al. (2008) conducted a global study of charged nucleation of H2SO4 and H2O in a chemical transport model, using nucleation rates calculated with the model of Yu (2007).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
