            "target_entity_type": "Variable",
            "paragraph": "The regional VPM GPP product has been validated using both flux tower data and the solar-induced chlorophyll fluorescence (SIF) data from the Global Ozone Monitoring Experiment-2 (GOME-2) across North America46.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
