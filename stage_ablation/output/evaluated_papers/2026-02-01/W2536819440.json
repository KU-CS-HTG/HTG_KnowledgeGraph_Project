            "target_entity_instance": "decorrelation timescale of 15 days at the sea surface",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "The decorrelation timescale in Ishii et al. (2006) is 15 days at the sea surface and increases linearly as 2 days/100 m.",
            "ontology_conformed": true,
            "evidence_validated": true,
