    "obs_and_metrics": [],
    "innovation": "This paper presents a new ice budget for Antarctica, revealing a significant negative mass balance primarily driven by its novel, higher estimates of basal melting beneath floating ice shelves, a previously underestimated component of ice loss.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "deep vertical convection",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Ross Sea",
            "target_entity_type": "No_Country_Region",
            "paragraph": "In the Ross Sea, deep vertical convection is concentrated along the western and southern coastlines and may not penetrate through the more centrally located inflows and outflows.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Antarctic Bottom Water formation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Weddell Sea",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The ISW results from 86 km\u00b3 year of the ice-shelf base melting into dense sea water that drains into the sub-ice cavity. Such outflows are known to contribute to Antarctic Bottom Water formation in the Weddell Sea (Foldvik and others, 1985; Jacobs and others, 1985).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Circumpolar Deep Water flow",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "George VI Ice Shelf",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The second melting mode is dependent upon transport beneath the ice shelves of water that is substantially warmer than the surface freezing temperature. An oceanic heat source derived from the Circumpolar Deep Water (CDW) has been documented near several ice shelves and ice tongues (e.g. Jacobs and others, 1979; Foldvik and others, 1985) and has the potential to melt large volumes of basal ice. CDW about 3\u00b0C warmer than the in situ melting point flows beneath George VI Ice Shelf, which has a relatively high mean basal melt rate of 2.1 m year\u00b9 (Potter and Paren, 1985).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
