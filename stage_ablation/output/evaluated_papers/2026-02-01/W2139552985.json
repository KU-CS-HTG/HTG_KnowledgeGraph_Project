        },
        {
            "source_entity_instance": "GCM Ensemble",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "CLM4",
            "target_entity_type": "SourceComponent",
            "paragraph": "Several models produced very low biases relative to the ERA-Interim-forced RACMO2, in particular those models using the NCAR Community Land Model version 4 (ref. 43; CLM4), shown in red in Supplementary Fig. 7. These five models are all unique in their full GCM set-ups by incorporating different configurations of atmospheric, ocean, or sea ice modules, but all share the common CLM4 land model.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "RACMO2",
