            "relation": "PART_OF_PROJECT",
            "target_entity_instance": "CMIP5",
            "target_entity_type": "Project",
            "paragraph": "To characterize ice shelf melting more directly and within a longer temporal framework, we investigated T2m simulated by a subset of five well-suited global climate models (hereafter 'GCM Ensemble') from the Coupled Model Intercomparison Project 5 (ref. 22; CMIP5; see Methods).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
