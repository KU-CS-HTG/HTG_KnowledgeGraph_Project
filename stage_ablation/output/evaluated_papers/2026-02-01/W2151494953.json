    "title": "Technical Note: Estimating aerosol effects on cloud radiative forcing",
    "venue": {
        "name": "Atmospheric chemistry and physics",
        "id": "https://openalex.org/S162708223",
        "type": "journal"
    },
    "publication_year": 2013,
    "authors": [
        {
            "id": "https://openalex.org/A5063882902",
            "display_name": "S. J. Ghan",
