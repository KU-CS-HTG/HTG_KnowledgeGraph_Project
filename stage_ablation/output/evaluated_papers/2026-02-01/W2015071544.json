            "target_entity_instance": "Slinn and Slinn (1980) deposition model",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Over the ocean, we have implemented the Slinn and Slinn (1980) deposition model for natural waters. The Slinn and Slinn (1980) model divides the marine boundary layer into a viscous sublayer, with a thickness of ~0.1\u20131 mm, and a surface layer above.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
