        },
        {
            "source_entity_instance": "LOVECLIM",
            "source_entity_type": "Source",
            "relation": "HAS_SIMULATION_TYPE",
            "target_entity_instance": "transient",
            "target_entity_type": "SimulationType",
            "paragraph": "Initial conditions for the LOVECLIM transient run were obtained by conducting an equilibrium spin-up simulation using an atmospheric CO2 content of 207.5 ppmv, orbital forcing for the time 50 ka BP and an estimate of the 50 ka BP ice-sheet orography and albedo which were obtained from a 130ka off-line ice-sheet model simulation (Abe-Ouchi et al., 2007). In the subsequent transient run greenhouse gases, orbital and ice-sheet forcing were updated continuously following the methodology of Timm et al. (2008).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "LOVECLIM",
            "source_entity_type": "Source",
            "relation": "HAS_SIMULATION_TYPE",
            "target_entity_instance": "coupled",
            "target_entity_type": "SimulationType",
            "paragraph": "Note that our coupled model does not include an interactive ice sheet. Therefore, freshwater withholding from the ocean during phases of ice-sheet growth and freshwater release into the ocean as a result of ice-sheet calving and ablation are not explicitly captured.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Atlantic Meridional Overturning Circulation",
