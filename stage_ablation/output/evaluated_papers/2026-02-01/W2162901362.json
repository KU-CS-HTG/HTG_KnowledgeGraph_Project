    "innovation": "This paper uses recent observations of the global energy budget to constrain climate sensitivity, finding that data from the 2000s suggests a lower and more tightly constrained transient climate response (TCR) than previously estimated or simulated by some climate models.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "CMIP5 ensemble",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "equilibrium climate sensitivity",
            "target_entity_type": "Metric",
            "paragraph": "The range derived from the 2000s overlaps with estimates from earlier decades and with the range of ECS values from current climate models10 (ECS values in the CMIP5 ensemble\u00b9\u00b3 are 2.2-4.7 \u00b0C), although it is moved slightly towards lower values.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CMIP5 ensemble",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "transient climate response",
            "target_entity_type": "Metric",
            "paragraph": "Our results match those of other observation-based studies\u00b9\u2075 and suggest that the TCRs of some of the models in the CMIP5 ensemble10 with the strongest climate response to increases in atmospheric CO2 levels may be inconsistent with recent observations \u2014 even though their ECS values are consistent and they agree well with the observed climatology.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "ocean component",
            "source_entity_type": "SourceComponent",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "ocean",
            "target_entity_type": "Realm",
            "paragraph": "For AQ, we derive annual estimates of the change in total heat content of the Earth system for the period 1970 to 2009, by combining data-based estimates for all the main components of the Earth system (ocean, continent, ice and atmosphere); the ocean component dominates the heat uptake (see Supplementary Section S1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "continent component",
            "source_entity_type": "SourceComponent",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "land",
            "target_entity_type": "Realm",
            "paragraph": "For AQ, we derive annual estimates of the change in total heat content of the Earth system for the period 1970 to 2009, by combining data-based estimates for all the main components of the Earth system (ocean, continent, ice and atmosphere); the ocean component dominates the heat uptake (see Supplementary Section S1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "atmosphere component",
            "source_entity_type": "SourceComponent",
            "relation": "APPLIES_TO_REALM",
            "target_entity_instance": "atmos",
            "target_entity_type": "Realm",
            "paragraph": "For AQ, we derive annual estimates of the change in total heat content of the Earth system for the period 1970 to 2009, by combining data-based estimates for all the main components of the Earth system (ocean, continent, ice and atmosphere); the ocean component dominates the heat uptake (see Supplementary Section S1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CMIP5 ensemble",
            "source_entity_type": "Source",
            "relation": "HAS_SIMULATION_TYPE",
            "target_entity_instance": "transient",
            "target_entity_type": "SimulationType",
            "paragraph": "For AF, we use the multi-model average of the CMIP5 ensemble of climate simulations10 with emissions that follow a medium-to-low representative concentration pathway (RCP4.5). We include the historic record from 1850\u20132005 and the RCP4.5 scenario values from 2006\u20132010, scaled to match an ensemble of possible forcing estimates for 2010 (see Supplementary Section S1) to adjust for fast feedbacks and capture uncertainties.",
            "ontology_conformed": true,
