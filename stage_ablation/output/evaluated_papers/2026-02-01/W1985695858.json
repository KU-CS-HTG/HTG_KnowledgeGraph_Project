            "relation": "HAS_METRIC",
            "target_entity_instance": "anomaly correlation coefficient",
            "target_entity_type": "Metric",
            "paragraph": "Predictive skills in the initialized hindcast and uninitialized runs are measured per grid-point by the anomaly correlation coefficient and with the same number of initial cases (that is, 10 cases) by comparing with the assimilation run that is comparable to the observation.",
            "ontology_conformed": true,
