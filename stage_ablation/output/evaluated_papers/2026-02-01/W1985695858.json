        },
        {
            "source_entity_instance": "MIROC v3.2",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "root-mean-squared error skill",
            "target_entity_type": "Metric",
            "paragraph": "However, predictive skill in the uninitialized runs sometimes even outperforms that of the initialized run: the SLP root-mean-squared error skill at 25\u201329 months (Supplementary Fig. 7a) and the SST skills at 42-49 months lead time (Fig. 4b and Supplementary Fig. 7b).",
            "ontology_conformed": true,
