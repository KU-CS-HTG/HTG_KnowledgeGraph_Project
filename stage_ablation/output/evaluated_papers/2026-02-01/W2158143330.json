    "obs_and_metrics": [],
    "innovation": "This paper reconstructs global and hemispheric temperatures for the past 400 years from 308 glacier length records, providing a fully independent physical proxy that confirms the pronounced warming of the twentieth century and aligns with existing multi-proxy reconstructions for the pre-instrumental period.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "Temperature reconstruction from glacier length fluctuations (Oerlemans, 2005)",
            "source_entity_type": "Source",
            "relation": "HAS_SUBSEQUENT_VERSION",
            "target_entity_instance": "Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)",
            "target_entity_type": "Source",
            "paragraph": "Comparison with the results of Oerlemans (2005, see Supplementary Material) shows that the present reconstruction [Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)] with more data has a less pronounced warming in the period up to 1940, more in line with the instrumental record. In addition, the best estimate of the present reconstruction [Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)] shows a cooler period in the mid-19th century than the best estimate of Oerlemans (2005). These differences are not caused by the difference in averaging method (Appendix B) and must thus result from the additional data. Also, the estimated uncertainty of the present reconstruction is larger, despite the increased number of records.",
            "ontology_conformed": true,
            "evidence_validated": false,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "linear first-order response equation",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "To relate the glacier length fluctuations to fluctuations in temperature, we follow the approach of Oerlemans (2005), who uses a linear first-order response equation",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "decadal resolution",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "The temperature reconstruction from glacier length fluctuations has no annual resolution, inherent to the slow response of a glacier to perturbations of its mass balance. For the first period (1600\u20131700), the temperature record has a lower than decadal resolution, due to the lower resolution of the length records (Appendix C).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "constant glacier width",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "The only geometric factor included in the analytical glacier model is the average slope, while assuming a constant glacier width.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Temperature reconstruction from glacier length fluctuations (Leclercq and Oerlemans, 2011)",
            "source_entity_type": "Source",
