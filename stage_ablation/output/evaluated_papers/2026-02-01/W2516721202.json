        },
        {
            "source_entity_instance": "ACCESS1.0",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "root mean square difference",
            "target_entity_type": "Metric",
            "paragraph": "The LAI sensitivity simulation (ACCESS1.0L) gives northern continental JJA temperature (mean = 19.22) much closer to ACCESS1.0 (root mean square difference of 0.4 K) than to ACCESS1.1 (RMS difference of 2.7 K), indicating that a change in LAI has not significantly changed the ACCESS1.0 simulation of the northern continent in summer.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "ACCESS1.1",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "root mean square difference",
            "target_entity_type": "Metric",
            "paragraph": "The LAI sensitivity simulation (ACCESS1.0L) gives northern continental JJA temperature (mean = 19.22) much closer to ACCESS1.0 (root mean square difference of 0.4 K) than to ACCESS1.1 (RMS difference of 2.7 K), indicating that a change in LAI has not significantly changed the ACCESS1.0 simulation of the northern continent in summer.",
            "ontology_conformed": true,
            "evidence_validated": true,
