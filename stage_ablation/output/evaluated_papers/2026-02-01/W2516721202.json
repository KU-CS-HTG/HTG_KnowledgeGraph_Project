        },
        {
            "source_entity_instance": "ACCESS1.0",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "Mean screen temperature biases",
            "target_entity_type": "Metric",
            "paragraph": "Mean screen temperature biases relative to ERAi (Fig. 4) are similar for ACCESS1.0 and ACCESS1.1, at least across the tropics and more generally in DJF.",
            "ontology_conformed": true,
