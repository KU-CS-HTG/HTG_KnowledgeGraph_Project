{
    "uri": "https://openalex.org/W2117293742",
    "title": "A critical look at spatial scale choices in satellite-based aerosol indirect effect studies",
    "venue": {
        "name": "Atmospheric chemistry and physics",
        "id": "https://openalex.org/S162708223",
        "type": "journal"
    },
    "publication_year": 2010,
    "authors": [
