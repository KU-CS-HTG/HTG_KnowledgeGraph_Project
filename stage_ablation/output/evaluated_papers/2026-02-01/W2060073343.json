            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "central and eastern equatorial Atlantic",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The regional focus of TACE was on the central and eastern equatorial Atlantic, characterized by the development of the Atlantic cold tongue (ACT) during boreal summer.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
