        },
        {
            "source_entity_instance": "West African Monsoon",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Africa",
            "target_entity_type": "Continent",
            "paragraph": "The year-to-year variability of the ACT sea surface temperature (SST) has a strong influence on regional climate variations, including the strength and onset date of the West African Monsoon (WAM).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "ocean circulation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Gulf of Guinea",
            "target_entity_type": "No_Country_Region",
            "paragraph": "TACE with its backbone, the Prediction and Research Moored Array in the Tropical Atlantic (PIRATA), was closely linked to other initiatives in the tropical Atlantic, such as the French EGEE (Etude de la circulation oc\u00e9anique et de sa variabilit\u00e9 dans le Golfe de Guin\u00e9e) program and the African Monsoon Multidisciplinary Analyses (AMMA).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "coastal upwelling",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "eastern tropical Atlantic",
            "target_entity_type": "No_Country_Region",
            "paragraph": "As this region still remains underrepresented in the available in situ observational datasets, new observational programs have been developed in the eastern tropical Atlantic, with a particular focus on the coastal upwelling regions.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
