    "innovation": "This paper introduces a novel application of extreme value theory, specifically tail dependence, to evaluate the consistency of precipitation extremes among various gridded datasets, revealing significant discrepancies between products derived from rain gauges versus satellites over the conterminous United States.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "Maurer",
            "source_entity_type": "Source",
            "relation": "HAS_SUBSEQUENT_VERSION",
            "target_entity_instance": "Livneh",
            "target_entity_type": "Source",
            "paragraph": "The Maurer and Livneh data sets, the latter being a revised and lengthened version of the former, employ a variant of an inverse distance and directional weighting scheme (Shepard 1968).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "ILIAD CESM",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "CESM",
            "target_entity_type": "SourceComponent",
            "paragraph": "The InitiaLIzed-ensemble, Analyze, and Develop (ILIAD) framework (O\u2019Brien et al. 2016) was used to generate a five year time series of re-forecasts in order to compare observed and simulated weather events across multiple resolutions. It employs the Community Earth System Model (CESM), initialized by the US National Center for Environmental Protection (NCEP) reanalysis data set.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CPC",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "optimal interpolation",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The CPC unified gauge-based analysis of daily precipitation over CONUS is based upon an optimal interpolation approach following (Gandin and Hardin 1965).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Maurer",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "inverse distance and directional weighting scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The Maurer and Livneh data sets, the latter being a revised and lengthened version of the former, employ a variant of an inverse distance and directional weighting scheme (Shepard 1968).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Livneh",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "inverse distance and directional weighting scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The Maurer and Livneh data sets, the latter being a revised and lengthened version of the former, employ a variant of an inverse distance and directional weighting scheme (Shepard 1968).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "PRISM",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "linear regression",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The PRISM (Precipitation-Elevation Regressions on Independent Slopes Model) product itself is generated from the PRISM algorithm that, in common with CPC, uses a linear regression approach combining gauge data by weighting based upon factors such as location, elevation, coastal proximity, topographic facet orientation and others.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Daymet",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "spatial convolution",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Daymet uses a different approach based upon spatial convolution, described by Thornton et al. (1997).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "gridded precipitation data sets",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "tail dependence",
            "target_entity_type": "Metric",
            "paragraph": "Noting a strong imperative to understand precipitation extremes, and that considerable uncertainty affects observational data sets, this paper compares the representation of extremes in a number of widely used daily gridded products, derived from rain gauge data, satellite retrieval and reanalysis for the conterminous United States. Analysis is based upon the concept of \"tail dependence\" arising in multivariate extreme value theory, and we infer the level of temporal dependence in the joint tail of the precipitation probability distribution for pairwise comparisons of products.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "gridded precipitation data sets",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "linear correlation",
            "target_entity_type": "Metric",
            "paragraph": "Linear correlation between products is also computed.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "rain gauge",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "precipitation",
            "target_entity_type": "Variable",
            "paragraph": "The two broad categories of measurement system used for large scale observations, rain gauge networks and satellite based radar, each suffers from its own set of limitations. Rain gauges can provide an accurate and continuous record at a single location, although they may be affected by a variety of errors, including undercatch (Groisman and Legates 1994; Chvila et al. 2005; Kochendorfer et al. 2017).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "satellite based radar",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "precipitation",
            "target_entity_type": "Variable",
            "paragraph": "Continuous coverage is desirable, but difficulties are introduced because precipitation is not measured directly but inferred from microwave and infrared radar measurements, thus adding another layer of data processing that is subject to uncertainty and error (Iguchi et al. 2009; Tapiador et al. 2012).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": false
        },
        {
            "source_entity_instance": "radar",
            "source_entity_type": "Instrument",
            "relation": "MOUNTED_ON",
            "target_entity_instance": "satellite",
            "target_entity_type": "Platform",
            "paragraph": "Typically, networks of ground-based instruments providing in-situ measurements have the longest observational records although since the 1980s these have been augmented by a range of satellite based radar platforms.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Droughts",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "conterminous United States",
            "target_entity_type": "Country",
            "paragraph": "Understanding variation in precipitation\u2014particularly the extremes\u2014is critical for resource and emergency management, especially in the face of droughts and floods in a changing climate. The quality of the observational record is therefore also critical.",
            "ontology_conformed": true,
            "evidence_validated": true,
