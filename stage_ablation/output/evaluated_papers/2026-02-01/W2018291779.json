        {
            "source_entity_instance": "HadISST 1.1",
            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "sea surface temperatures",
            "target_entity_type": "Variable",
            "paragraph": "Observed shifts in spring phenology (days dec\u22121) for marine taxonomic or functional groups against expected shift in spring phenology taken as shift in seasonal sea surface temperatures. Fifty-one observed shifts taken from 17 published studies. Expected distributional and phenology shifts over 1960\u20132009 calculated using the Hadley Centre data set (HadISST 1.1) and methods presented in ref. 8. April temperatures used for Northern Hemisphere spring phenology and October temperatures for Southern Hemisphere phenology.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "HadISST 1.1",
            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "temperature isotherms",
            "target_entity_type": "Variable",
            "paragraph": "For each quantitative shift in our database for distribution and phenology, excluding null observations, expectations regarding the velocity of temperature isotherms and the shift in seasonal temperatures were produced using the data sets and methods described in ref. 8 over the period 1960\u20132009. Distribution shifts were matched to isotherm velocity values by averaging all values from 1\u00b0 grid cells within a circular buffer distance (size of reported shift) from each observation. Expected distributional and phenology shifts over 1960\u20132009 calculated using the Hadley Centre data set (HadISST 1.1) and methods presented in ref. 8.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
