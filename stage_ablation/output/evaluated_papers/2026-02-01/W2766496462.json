    "innovation": "This paper presents a global, moderate-resolution gross primary production dataset (2000\u20132016) derived from an improved light use efficiency model that incorporates a state-of-the-art gap-filling algorithm and a separate treatment for C3/C4 photosynthesis pathways to address limitations in existing products.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "vegetation photosynthesis model (VPM)",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "light use efficiency scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The VPM model follows the light use efficiency scheme and estimates GPP as the product of light absorption by chlorophyll of the vegetation (APARchl) and the efficiency (\u03b5g) that converts the absorbed energy to carbon fixed by plants through photosynthesis:",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "vegetation photosynthesis model (VPM)",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "vegetation index (VI) gap-filling and smoothing algorithm",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "This GPP dataset is based on an improved light use efficiency theory and is driven by satellite data from MODIS and climate data from NCEP Reanalysis II. It also employs a state-of-the-art vegetation index (VI) gap-filling and smoothing algorithm and a separate treatment for C3/C4 photosynthesis pathways. All these improvements aim to solve several critical problems existing in current GPP products. With a satisfactory performance when validated against in situ GPP estimates, this dataset offers an alternative GPP estimate for regional to global carbon cycle studies.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "vegetation photosynthesis model (VPM)",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "separate treatment for C3/C4 photosynthesis pathways",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "This GPP dataset is based on an improved light use efficiency theory and is driven by satellite data from MODIS and climate data from NCEP Reanalysis II. It also employs a state-of-the-art vegetation index (VI) gap-filling and smoothing algorithm and a separate treatment for C3/C4 photosynthesis pathways. All these improvements aim to solve several critical problems existing in current GPP products. With a satisfactory performance when validated against in situ GPP estimates, this dataset offers an alternative GPP estimate for regional to global carbon cycle studies.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "land surface reflectance",
            "target_entity_type": "Variable",
            "paragraph": "Enhanced Vegetation Index (EVI)36 and Land Surface Water Index (LSWI)37 are two major inputs for the VPM model, both of which are calculated from the MOD09A1 C6 500 m 8-day land surface reflectance dataset.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MOUNTED_ON",
            "target_entity_instance": "Terra",
            "target_entity_type": "Platform",
            "paragraph": "Using this method, we not only filled bad observations caused by atmospheric conditions, but also reconstructed the EVI for periods when no observations were made by the Terra satellite, e.g., in the year 2000 before DOY 49.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
