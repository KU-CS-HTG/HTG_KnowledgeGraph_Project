    "obs_and_metrics": [],
    "innovation": "This paper presents a complete, 224,000-year, absolute-dated speleothem record from China, demonstrating that the East Asian monsoon is driven by Northern Hemisphere summer insolation and that the pacing of millennial-scale monsoon events is linked to global ice sheet size over two glacial cycles.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "East Asian monsoon",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "China",
            "target_entity_type": "Country",
            "paragraph": "High-resolution speleothem records from China have provided insights into the factors that control the strength of the East Asian monsoon\u00b94. Our understanding of these factors remains incom- plete, however, owing to gaps in the record of monsoon history over the past two interglacial-glacial cycles. In particular, missing sec- tions have hampered our ability to test ideas about orbital-scale controls on the monsoon5-7, the causes of millennial-scale events8,9 and relationships between changes in the monsoon and climate in other regions.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Hubei province",
            "source_entity_type": "Country_Subdivision",
            "relation": "IN_COUNTRY",
            "target_entity_instance": "China",
            "target_entity_type": "Country",
            "paragraph": "Sanbao cave is in Hubei province, central China, on the northern slope of Mt Shennongjia, near the southern edge of the Chinese loess plateau (110\u00b0 26\u2032 E, 31\u00b0 40\u2032 N, 1,900 m above sea level).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "North Atlantic Deep Water formation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "North Atlantic",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Forcing mechanisms for millennial-scale events have been explained by changing rates of North Atlantic Deep Water formation, resulting in changing heat transport to the North Atlantic\u00b9\u2077.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Asian Monsoon",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Indian Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "This contrasts with an idea that ties the AM precession cycle to latent heat transfer from the Southern Hemisphere, on the basis of a lag of the AM (as inferred from sediment cores from the Indian\u00b9\u2078 and Pacific Oceans\u00b9\u2079) of ~6 \u00b1 1 kyr relative to 21 July insolation.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Asian Monsoon",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Pacific Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "This contrasts with an idea that ties the AM precession cycle to latent heat transfer from the Southern Hemisphere, on the basis of a lag of the AM (as inferred from sediment cores from the Indian\u00b9\u2078 and Pacific Oceans\u00b9\u2079) of ~6 \u00b1 1 kyr relative to 21 July insolation.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "inductively coupled plasma mass spectrometer",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "230Th",
            "target_entity_type": "Variable",
            "paragraph": "Subsamples were drilled along growth axes for 230Th dating at the Minnesota Isotope Laboratory on an inductively coupled plasma mass spectro- meter (Thermo-Finnigan ELEMENT) using procedures described in refs 3 and 4.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Finnigan MAT-253 gas-source mass spectrometer",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "oxygen isotope ratios (818O)",
            "target_entity_type": "Variable",
            "paragraph": "Approximately 100 \u00b5g of powder samples were drilled along growth axes of stalagmites and analysed with an on-line, automated carbonate preparation system (Kiel III), linked to a Finnigan MAT-253 gas- source mass spectrometer at the Isotope Laboratory at Nanjing Normal University, China. Standards (NBS19) were run every nine samples to check reproducibility. The standard deviation calculated from the NBS19 measure- ments is ~0.06% for 818O values.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
