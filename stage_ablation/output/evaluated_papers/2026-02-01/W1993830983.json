            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Discrete Ordinate Radiative Transfer",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "We compute inelastic rotational-Raman scattering (RRS) in the O2 A- and B-bands using the LInearized Discrete Ordinate Radiative Transfer (LIDORT-RRS) code (Spurr et al., 2008).",
            "ontology_conformed": false,
