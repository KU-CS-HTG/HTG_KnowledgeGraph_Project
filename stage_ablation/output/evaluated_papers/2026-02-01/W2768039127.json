            "eval": true
        },
        {
            "source_entity_instance": "MIROC-based offline biogeochemical model",
            "source_entity_type": "SourceComponent",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "alkalinity (ALK)",
            "target_entity_type": "Variable",
            "paragraph": "This biogeochemical model is a modified version of the nutrient-phytoplankton-zooplankton-detritus (NPZD) ecosystem model of Keller et al. (2012). The model includes two phytoplankton classes (nitrogen fixers and other phytoplankton), zooplankton, particulate detritus, nitrate (NO3), phosphate (PO4), dissolved oxygen (O2), dissolved inorganic carbon (DIC), alkalinity (ALK), two carbon isotopes (13C and 14C), and an ideal age tracer.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC 4m AOGCM",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Optimal uptake kinetics",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Optimal uptake kinetics, which assume a physiological trade-off between the efficiency of nutrients encountered at the cell surface and the maximum assimilation rate (Smith et al., 2009), are adopted for the nutrient limitation of the growth rate of phytoplankton.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": false,
            "eval": false
        },
        {
            "source_entity_instance": "MIROC 4m AOGCM",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "OCMIP-2 air-sea gas exchange and carbon chemistry",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The formulations of air-sea gas exchange and carbon chemistry follow the protocols of the Ocean Carbon Cycle Model Intercomparison Project \u2013 Phase 2 (OCMIP-2; http: //ocmip5.ipsl.jussieu.fr/OCMIP/, last access: 6 July 2018) (Najjar and Orr, 1999).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "AMOC",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Atlantic Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The AMOC decreases from 16.5 to 3.8 Sv in the first 500 years and does not recover by the end of the simulation.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "AABW",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Southern Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The strength of the Antarctic Bottom Water (AABW) formation decreases from 6.2 to 2.4 Sv in the first 500 years.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC 4m AOGCM",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "cumulative CO2 uptake reduction of 13%",
            "target_entity_type": "Metric",
            "paragraph": "At the time of CO2 quadrupling (year 140), the cumulative CO2 uptake is 567 PgC in the global warming run (GW_bio) and 654 PgC in the constant climate run (CTL_bio), a projected reduction due to global warming of 13%.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC 4m AOGCM",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "cumulative CO2 uptake reduction of 30%",
            "target_entity_type": "Metric",
            "paragraph": "At the end of the simulation, the cumulative CO2 uptake is 2028 PgC and the uptake reduction due to global warming increases to 30% (Fig. 3a and Table 1).",
            "ontology_conformed": true,
            "evidence_validated": true,
