    "obs_and_metrics": [],
    "innovation": "This paper demonstrates that the stability of the Atlantic thermohaline circulation is highly sensitive to the rate of atmospheric CO\u2082 increase, showing a rapid rise can trigger a permanent collapse where a slower rise to the same concentration only causes a slowdown.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "Atlantic thermohaline circulation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "North Atlantic Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Anticipated future changes in today's climate system due to human activities have the potential to weaken the thermohaline circulation of the North Atlantic Ocean, which would greatly modify estimates of future oceanic CO2 uptake. Here we use a simple coupled atmosphere\u2013ocean climate model to show that the Atlantic thermohaline circulation is not only sensitive to the final atmospheric CO2 concentration attained, but also depends on the rate of change of the CO2 concentration in the atmosphere.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
