    "innovation": "This paper projects that under most future carbon dioxide scenarios, warming in Greenland will surpass the critical threshold of ~3\u00b0C, triggering the near-complete and irreversible melting of its ice-sheet and a consequent 7-meter rise in global sea level.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "loss of the Greenland ice-sheet",
            "source_entity_type": "Natural_Hazard",
            "relation": "IS_OF_TYPE",
            "target_entity_instance": "Melting",
            "target_entity_type": "NaturalHazardType",
            "paragraph": "The Greenland ice-sheet would melt faster in a warmer climate and is likely to be eliminated \u2014 except for residual glaciers in the mountains \u2014 if the annual average temperature in Greenland increases by more than about 3 \u00b0C.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "loss of the Greenland ice-sheet",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Greenland",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The Greenland ice-sheet would melt faster in a warmer climate and is likely to be eliminated \u2014 except for residual glaciers in the mountains \u2014 if the annual average temperature in Greenland increases by more than about 3 \u00b0C. This could raise the global average sea-level by 7 metres over a period of 1,000 years or more. We show here that concentrations of greenhouse gases will probably have reached levels before the year 2100 that are sufficient to raise the temperature past this warming threshold.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Greenland",
            "source_entity_type": "No_Country_Region",
            "relation": "HAS_CLIMATE_ZONE",
            "target_entity_instance": "Polar",
            "target_entity_type": "ClimateZone",
            "paragraph": "We take into account the AOGCMs' prediction that future warming in Greenland will be larger than the global average: warming is greater at high northern latitudes because the loss of snow and sea ice creates positive feedbacks, due in particular to the reduced reflection of sunlight.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
    ],
