        {
            "source_entity_instance": "North Atlantic Oscillation",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "eastern Alps",
            "target_entity_type": "No_Country_Region",
            "paragraph": "In the western Alps, both temperature and winter precipitation anomalies lead to a weak anti-correlation of mass balances with the NAO, while in the eastern Alps, the influences of winter precipitation and temperature anomalies tend to cancel each other, and only on the southern side a slight anti-correlation of mass balances with the NAO prevails.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Arctic Oscillation",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Scandinavia",
            "target_entity_type": "No_Country_Region",
            "paragraph": "and Rasmussen and Conway (2005) find correlations between the Arctic Oscillation and mass balances of 12 Scandinavian glaciers to be stronger than between NAO and mass balances.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Atlantic Multidecadal Oscillation",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Swiss Alps",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Huss et al. (2010) find a rather strong influence of the (longer term) Atlantic Multidecadal Oscillation on mass balances of glaciers in the Swiss Alps.",
            "ontology_conformed": true,
            "evidence_validated": true,
