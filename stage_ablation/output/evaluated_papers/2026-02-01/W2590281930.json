        },
        {
            "source_entity_instance": "HadGEM2-ES",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "TOPMODEL scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Wetland CH4 emissions are computed within HadGEM2-ES at each model timestep19 with a TOPMODEL scheme21,63,64 here configured with a recently derived high-resolution global topographic index data set65, which describes the propensity for subgrid areas of soil moisture saturation.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "HadGEM2-ES",
