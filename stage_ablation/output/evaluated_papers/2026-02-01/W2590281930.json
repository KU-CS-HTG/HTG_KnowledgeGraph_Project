            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Guenther et al. BVOC scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "For the CH4 flux from oceans the Guenther et al. BVOC scheme31 simulates a 20% reduction in BVOC emissions between the pre-industrial and LGM.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
