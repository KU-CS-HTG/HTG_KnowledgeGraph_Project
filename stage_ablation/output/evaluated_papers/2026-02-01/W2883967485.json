            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Urals",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The Urals are among the few regions where blocking may increase in a future climate, although this is not robust across models, studies and even scenarios [128, 131\u2013133].",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
