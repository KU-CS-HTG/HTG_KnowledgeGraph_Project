            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Europe",
            "target_entity_type": "Continent",
            "paragraph": "The clear sky and air stagnation conditions underneath European blocking highs enhance the concentrations of particulate matter during winter and the photochemical build-up of surface ozone during spring and summer, eventually exceeding the air quality targets of these pollutants over some regions of Europe [70, 71].",
            "ontology_conformed": true,
            "evidence_validated": true,
