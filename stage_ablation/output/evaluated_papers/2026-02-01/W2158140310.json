            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Surface-flux formulation by Abdella and McFarlane (1996)",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The surface flux formulation used in AGCM3 is as described by Abdella and McFarlane (1996). This formulation is based on the Monin and Obukhov (1954) theory and employs the flux profile relations of Beljaars and Holtslag (1991).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
