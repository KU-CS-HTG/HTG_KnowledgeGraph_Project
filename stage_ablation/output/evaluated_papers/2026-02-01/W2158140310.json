            "target_entity_type": "PhysicalScheme",
            "paragraph": "AGCM3 uses the Scinocca and McFarlane (2000; hereafter SM) scheme for the parameterization of drag associated with unresolved mesoscale orography.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
