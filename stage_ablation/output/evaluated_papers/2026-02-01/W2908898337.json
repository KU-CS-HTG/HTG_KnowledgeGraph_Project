            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Antarctica",
            "source_entity_type": "No_Country_Region",
            "relation": "HAS_CLIMATE_ZONE",
            "target_entity_instance": "Polar",
            "target_entity_type": "ClimateZone",
            "paragraph": "We compiled a time series for the decade from 2007 to 2016 that comprises mean annual ground temperatures T, determined from temperatures measured in boreholes within the continuous and discontinuous permafrost zones in the Arctic (including the Subarctic), Antarctica and at high elevations outside the polar regions.",
            "ontology_conformed": true,
