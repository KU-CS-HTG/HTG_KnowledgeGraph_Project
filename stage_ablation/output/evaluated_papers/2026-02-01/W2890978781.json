            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Gaussian law for heterotrophic respiration",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Second, we calibrated the temperature dependency of the heterotrophic respiration rate of non-permafrost carbon (r) following a Gaussian law",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": false,
