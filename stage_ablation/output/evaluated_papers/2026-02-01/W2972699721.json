        {
            "source_entity_instance": "China CO2 emission accounts 2016\u20132017",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "Coefficient of Variation",
            "target_entity_type": "Metric",
            "paragraph": "Activity data is one of the most important sources of uncertainty of emissions. Due to the dual system and poor quality of the energy statistics28, China's energy consumption data may have a Coefficient of Variation (CV, the standard deviation divided by the mean) ranging from 5% to 30% ref. 29 depending on sectors: e.g., for electricity generation the CV is 5% ref. 30,31; industry and construction 10% ref. 9,32; transportation 16% ref. 33; residential 20% ref. 9; and primary industry 30% ref. 34.",
            "ontology_conformed": true,
