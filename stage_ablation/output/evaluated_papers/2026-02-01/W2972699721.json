        {
            "source_entity_instance": "China CO2 emission accounts 2016\u20132017",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "emission intensity",
            "target_entity_type": "Metric",
            "paragraph": "When considering the emission intensities (per GDP emissions), Ningxia (0.43 tons per thousand Yuan), Xinjiang (0.38) and Shanxi (0.34) are the top three provinces in 2016, indicating carbon-intensive economic structures of these provinces.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
