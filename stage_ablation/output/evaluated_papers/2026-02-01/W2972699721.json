            "target_entity_instance": "IPCC guidelines mass balance method",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "We use mass balances to calculate emissions according to the IPCC guidelines, as shown in Eq. 1. CEi = ADi \u00d7 NCVi \u00d7 CCi \u00d7 O",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "China CO2 emission accounts 2016\u20132017",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "IPCC guidelines process-related emissions calculation",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "According to the IPCC guidelines, process-related emissions can be calculated as follows: CEp = ADp \u00d7 EFp",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": false,
