            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "process-related emissions inventory",
            "source_entity_type": "SourceComponent",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "CO2 emissions",
            "target_entity_type": "Variable",
            "paragraph": "We include CO2 emissions from both fossil fuel combustion (i.e. energy-related emissions) and cement production (process-related emissions) in the emission accounts. Process-related emissions refer to CO2 emitted during chemical reactions of industrial production and the CO2 emissions are converted from industrial raw materials, rather than fossil fuels.",
            "ontology_conformed": true,
            "evidence_validated": false,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "China CO2 emission accounts 2016\u20132017",
            "source_entity_type": "Source",
