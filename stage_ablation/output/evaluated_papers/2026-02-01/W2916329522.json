            "eval": true
        },
        {
            "source_entity_instance": "AMOC",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Labrador and Irminger seas",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Volume redistribution associated with the formation history of intermediate water masses in the Labrador and Irminger seas can be important but they remain restricted to the lower limb of the AMOC (not shown).",
            "ontology_conformed": true,
