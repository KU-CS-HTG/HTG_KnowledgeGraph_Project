    "obs_and_metrics": [],
    "innovation": "This paper analyzes long-term global radiation data from about 400 sites, documenting a widespread \"global dimming\" trend from the 1950s to the 1980s, followed by a \"brightening\" recovery at 75% of stations, and attributes these changes to variations in aerosols and clouds.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "pyranometer",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "global radiation",
            "target_entity_type": "Variable",
            "paragraph": "The variation of global radiation (sum of direct solar and diffuse sky radiation) at the Earth's surface is examined based on pyranometer measurements at about 400 sites.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "BSRN",
            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "direct sky radiation",
            "target_entity_type": "Variable",
            "paragraph": "A large amount of quality data is available from the Baseline Surface Radiation Network (BSRN) for the period from 1992 to present. This short but very important period for detecting changes compensates for the missing data for a number of sites in WRDC. In addition, the BSRN data are usually of the highest quality, and offer direct and diffuse sky radiation with auxiliary meteorological data observed at the same sites.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
