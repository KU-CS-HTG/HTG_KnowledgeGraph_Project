            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "global radiation",
            "target_entity_type": "Variable",
            "paragraph": "Through these efforts a substantial amount of monthly mean global radiation data have been added to the existing GEBA to complete the updating work. This dataset is accessible at http://bsrn.ethz.ch.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "pyrheliometers",
