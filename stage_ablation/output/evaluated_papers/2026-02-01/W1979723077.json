            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "water vapour",
            "target_entity_type": "Variable",
            "paragraph": "A global network (FLUXNET) of continuous in situ measurements of land-atmosphere exchanges, including of water vapour, has been established over the last decade\u00b3, and these data can be used to estimate global ET dynamics.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
