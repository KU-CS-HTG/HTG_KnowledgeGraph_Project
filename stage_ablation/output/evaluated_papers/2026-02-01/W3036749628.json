            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Sahel",
            "target_entity_type": "No_Country_Region",
            "paragraph": "For the CMIP6 models, an inter-hemispheric gradient strongly appears to be the cause of model's uncertainties in simulating future precipitation change over the Sahel.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
