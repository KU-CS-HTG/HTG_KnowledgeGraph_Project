        {
            "source_entity_instance": "northern Hemisphere differential warming",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Sahel",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The negative correlation obtained over the tropics and the positive correlation obtained over the extratropics form the northern Hemisphere differential warming that is suggested to be one of the main sources of uncertainty in Sahel precipitation change (Park et al. 2015).",
            "ontology_conformed": true,
            "evidence_validated": true,
