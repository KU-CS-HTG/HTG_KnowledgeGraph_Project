    "obs_and_metrics": [],
    "innovation": "Using over five million species records, this paper provides large-scale empirical evidence that topographic microclimatic heterogeneity substantially reduces local extinction risk for plants and insects under recent climate change, demonstrating the critical role of microrefugia in buffering species against warming.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "climate change",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "England",
            "target_entity_type": "Country",
            "paragraph": "Here, we show that microclimatic heterogeneity has strongly buffered species against regional extirpations linked to recent climate change. Using more than five million distribution records for 430 climate-threatened and range-declining species, population losses across England are found to be reduced in areas where topography generated greater variation in the microclimate.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Monthly mean 5 km \u00d7 5km gridded temperature data",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "UK Met Office",
            "target_entity_type": "Institute",
            "paragraph": "Climate change variables. Monthly mean 5 km \u00d7 5km gridded temperature data were obtained from the UK Met Office36 to calculate the mean summertime (June, July, August) temperature of each 10km \u00d7 10 km grid square in each year within the period of study (1970-2009).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "elevation data",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "US Geological Survey",
            "target_entity_type": "Institute",
            "paragraph": "Data availability. The datasets that support this study are available from the following sources: biological response data via the National Biodiversity Network (https://nbnatlas.org), climate change data via the UK Met Office (http://catalogue.ceda.ac.uk/uuid/87f43af9d02e42f483351d79b3d6162a), elevation data via the US Geological Survey (https://www2.jpl.nasa.gov/srtm/cbanddataproducts.html), LAI vegetation cover data via the National Oceanic and Atmospheric Administration (https://data.nodc.noaa.gov/cgi-bin/iso?id=gov.noaa.ncdc:C00898), land cover data under licence via EDINA (https://digimap.edina.ac.uk) and nitrogen deposition data via the Centre for Ecology and Hydrology (http://www.pollutantdeposition.ceh.ac.uk).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "0.05\u00b0 (~5km) dataset of daily LAI",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "National Oceanic and Atmospheric Administration",
            "target_entity_type": "Institute",
            "paragraph": "We used the 0.05\u00b0 (~5km) dataset of daily LAI from the National Oceanic and Atmospheric Administration\u00b3\u2079 to calculate the mean LAI in each 10 km \u00d7 10 km grid square from 1982 (the earliest date for which it is available) to 1989 and from 1990 to 2009, and calculated the log proportional change between the two periods (Supplementary Fig. 5).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "2007 land cover (vector) map",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "Centre for Ecology and Hydrology",
            "target_entity_type": "Institute",
            "paragraph": "The Centre for Ecology and Hydrology's 2007 land cover (vector) map\u2074\u2070 was sampled to a grid square resolution of 1 km \u00d7 1 km, and the proportion of each 10 km \u00d7 10 km grid square that was 'Arable and horticulture' or 'Improved grassland' was calculated.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "nitrogen deposition data",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "Centre for Ecology and Hydrology",
            "target_entity_type": "Institute",
            "paragraph": "Data availability. The datasets that support this study are available from the following sources: biological response data via the National Biodiversity Network (https://nbnatlas.org), climate change data via the UK Met Office (http://catalogue.ceda.ac.uk/uuid/87f43af9d02e42f483351d79b3d6162a), elevation data via the US Geological Survey (https://www2.jpl.nasa.gov/srtm/cbanddataproducts.html), LAI vegetation cover data via the National Oceanic and Atmospheric Administration (https://data.nodc.noaa.gov/cgi-bin/iso?id=gov.noaa.ncdc:C00898), land cover data under licence via EDINA (https://digimap.edina.ac.uk) and nitrogen deposition data via the Centre for Ecology and Hydrology (http://www.pollutantdeposition.ceh.ac.uk).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Defra\u2019s Concentration-Based Estimated Deposition model",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "Defra",
            "target_entity_type": "Institute",
            "paragraph": "Spatial data for England are available via outputs from Defra\u2019s Concentration-Based Estimated Deposition model\u2074\u2076 from 2004 onwards, which we used to calculate the mean annual total nitrogen deposition (kg of nitrogen per ha per yr) between 2004 and 2009 in each 10 km \u00d7 10 km grid square.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
