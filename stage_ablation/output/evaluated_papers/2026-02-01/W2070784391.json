            "relation": "IMPACTED_REGION",
            "target_entity_instance": "coastal regions of East Asia",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Monsoonal airflow from the tropics triggers torrential rainfall over coastal regions of East Asia in summer, bringing flooding situations into areas of growing population and industries.",
            "ontology_conformed": true,
