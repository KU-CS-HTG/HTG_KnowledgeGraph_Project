    "title": "Methane hydrate stability and anthropogenic climate change",
    "venue": {
        "name": "Biogeosciences",
        "id": "https://openalex.org/S13442111",
        "type": "journal"
    },
    "publication_year": 2007,
    "authors": [
        {
            "id": "https://openalex.org/A5086337448",
            "display_name": "David Archer",
