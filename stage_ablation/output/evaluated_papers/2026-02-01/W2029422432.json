    "obs_and_metrics": [],
    "innovation": "This paper uses global satellite data to present new evidence on the biophysical effects of forests on local climate, revealing that tropical forests cool year-round, temperate forests have net annual cooling, and boreal forests show net annual warming.",
    "kg_extraction_triplets": [
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MOUNTED_ON",
            "target_entity_instance": "Aqua",
            "target_entity_type": "Platform",
            "paragraph": "MODIS 8-day Aqua LST data (from MYD11C2) are retrieved in clear-sky conditions 40 and have overpass time at 1:30 and 13:30 hours, which are close to the times of daily minimum and maximum temperature.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MOUNTED_ON",
            "target_entity_instance": "Terra",
            "target_entity_type": "Platform",
            "paragraph": "It should be noted that the Aqua LST data start from July 2002, while other MODIS data incorporate information from the Terra satellite and start from January 2002.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "Land Surface Temperature",
            "target_entity_type": "Variable",
            "paragraph": "In this study, we use satellite data from the moderate resolution imaging spectroradiometer (MODIS) to investigate the biophysical impact of forests on local temperature at a global coverage and explore the controlling mechanisms. We compare land surface temperature (LST), ET, albedo, and other surface energy components between forest and nearby open land (grassland and cropland) from more than 11,000 samples across the globe (Supplementary Fig. 1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "Evapotranspiration",
            "target_entity_type": "Variable",
            "paragraph": "In this study, we use satellite data from the moderate resolution imaging spectroradiometer (MODIS) to investigate the biophysical impact of forests on local temperature at a global coverage and explore the controlling mechanisms. We compare land surface temperature (LST), ET, albedo, and other surface energy components between forest and nearby open land (grassland and cropland) from more than 11,000 samples across the globe (Supplementary Fig. 1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "shortwave albedo",
            "target_entity_type": "Variable",
            "paragraph": "The 16-day MODIS shortwave albedo product (MCD43C3) comprises black- sky and white-sky albedo.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "land cover",
            "target_entity_type": "Variable",
            "paragraph": "Land cover data from MCD12C1 with IGBP classification in 2012 are used to define forest and open land. Five forest types (evergreen needleleaf, evergreen broadleaf, deciduous needleleaf, deciduous broadleaf, and mixed forests) are combined into a single \u2018forest\u2019 category. \u2018Open land\u2019 refers to grassland and cropland. Only forest and open land (grass/crop) pixels with over 80% covered area are taken into account for our analysis.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MODIS",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "snow cover",
            "target_entity_type": "Variable",
            "paragraph": "Snow information is included as a part of the albedo data set. We calculate snow frequency as the percentage of days in a year where the land surface is covered by snow, reflecting the duration of snow cover.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        }
    ],
