        },
        {
            "source_entity_instance": "precipitation",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "western Pacific",
            "target_entity_type": "No_Country_Region",
            "paragraph": "There is also a distinct difference between the precipitation pattern: While the precipitation simulated by parametrized deep convection is located mainly south of the Equator, that simulated by resolving deep convection also forms a secondary band in the Northern hemisphere over the western Pacific.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "precipitation",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Pacific",
            "target_entity_type": "No_Country_Region",
            "paragraph": "One major difference is that two centers of precipitation response, one in the Pacific and one in the Indian Ocean, are simulated by ICON with parametrized convection, whereas only one, namely that in the Pacific, is simulated by ICON that resolves convection.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
