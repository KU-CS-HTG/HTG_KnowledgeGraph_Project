        {
            "source_entity_instance": "flood",
            "source_entity_type": "Natural_Hazard",
            "relation": "IS_OF_TYPE",
            "target_entity_instance": "Flood",
            "target_entity_type": "NaturalHazardType",
            "paragraph": "Floods impose a global risk that threatens approximately 1.81 billion people, or 23% of the world's population, who are exposed to depths of at least 15 cm given a 100-year return period flood (Rentschler et al., 2022).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "flash floods",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Kabul River basin",
            "target_entity_type": "No_Country_Region",
            "paragraph": "For example, the Kabul River basin, as the largest tributary of the Indus River, experiences more frequent and intense flash floods in the lowlands of the basin, especially when heavy monsoon rains combine with snowmelt runoff during the summer months (Abbaspour, 2013).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "flooding",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Huallaga River basin",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The objective of this research is to evaluate the potential impact of climate change on the magnitude of frequent (2-year) flood flows and the extent of flooded areas in the Huallaga River basin (HRB). In this context, the HRB has been identified by the National Water Authority (ANA) and the National Center for Disaster Risk Estimation, Prevention, and Reduction (CENEPRED) as one of the basins with the highest risk of flooding, a risk that is greater during El Ni\u00f1o events (CENEPRED, 2023). The HRB was identified as one of the areas with the highest risk of flooding in Peru (CENEPRED, 2023).",
            "ontology_conformed": true,
            "evidence_validated": false,
            "valid": true,
            "eval": true
        },
