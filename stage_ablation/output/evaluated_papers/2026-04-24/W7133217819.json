        },
        {
            "source_entity_instance": "floods",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Hu\u00e1nuco",
            "target_entity_type": "Country_Subdivision",
            "paragraph": "In Peru, this problem is no less serious, as floods are one of the main risks associated with natural disasters (BID, 2015), which between 2003 and 2022 have affected 2,154,434 inhabitants, mainly concentrated in northern Peru in the departments of Loreto, San Mart\u00edn, and Hu\u00e1nuco (INDECI, 2023).",
            "ontology_conformed": true,
