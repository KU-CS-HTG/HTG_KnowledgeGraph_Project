        {
            "source_entity_instance": "Water scarcity",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Lake Urmia Basin",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Agriculture in arid and semi-arid regions has always faced serious challenges due to water scarcity, climate fluctuations, and declining soil quality. In recent decades, these challenges have intensified, especially under the influence of climate change, rapid population growth, and excessive exploitation of natural resources, leading to decreased agricultural productivity, reduced product quality, and increased vulnerability of farmers' livelihoods in these regions. The decline in groundwater levels, increased soil salinity, and decreased land productivity are direct consequences of these conditions, significantly impacting crop yields and agricultural sustainability, particularly in the Lake Urmia Basin (3, 4).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Water scarcity",
            "source_entity_type": "Natural_Hazard",
            "relation": "AFFECTED_REGION",
            "target_entity_instance": "Miandoab Plain",
            "target_entity_type": "No_Country_Region",
            "paragraph": "However, in recent years, extensive withdrawals from deep wells, particularly during periods of water scarcity, have caused declines in groundwater levels and exacerbated soil salinity. Estimates indicate that annual groundwater withdrawal in the region exceeds 240 million cubic meters, constituting about 20% of the total groundwater extraction in the Lake Urmia Basin (25).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
