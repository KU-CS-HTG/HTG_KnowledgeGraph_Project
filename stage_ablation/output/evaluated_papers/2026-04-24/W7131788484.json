        {
            "source_entity_instance": "Winter Snow Cover",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Tibetan Plateau",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Abstract. Snow cover over Tibetan Plateau (TP) is not only a key land forcing for the regional and global climate but also an important water resource for surround regions. However, state-of-the-art climate models still exhibit substantial biases in simulating winter snow cover over the TP, which constitutes one of the major sources of uncertainty in climate prediction.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Community Land Model version 5 (CLM5)",
            "source_entity_type": "Source",
            "relation": "HAS_SIMULATION_TYPE",
            "target_entity_instance": "offline simulation",
            "target_entity_type": "SimulationType",
            "paragraph": "To conduct the offline simulation of CLM5 over TP, the 3-hourly China meteorological forcing dataset v1.6 (CMFD 1.6; https://data.tpdc.ac.cn/zh-hans/data/8028b944-daaa-4511-8769-965612652c49/) (Yang et al., 2010; He et al., 2020) with a horizontal resolution of 0.1\u00b0 \u00d7 0.1\u00b0 for the period 1979\u20132018 was obtained, CMFD 1.6 includes the surface air temperature, surface pressure, specific humidity, wind speed, precipitation, downward shortwave and longwave radiation.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
