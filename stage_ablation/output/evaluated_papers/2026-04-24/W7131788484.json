            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "land surface temperature",
            "target_entity_type": "Variable",
            "paragraph": "The MODIS monthly land surface temperature product with a 0.05\u00b0 \u00d7 0.05\u00b0 spatial resolution from 2002 to 2011 was also used (https://ladsweb.modaps.eosdis.nasa.gov/missions-and-measurements/products/MOD11C3).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
