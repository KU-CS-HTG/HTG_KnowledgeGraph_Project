        },
        {
            "source_entity_instance": "Moderate Resolution Imaging Spectroradiometer (MODIS)",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "stem area index (SAI)",
            "target_entity_type": "Variable",
            "paragraph": "The SAI data which is used as the proxy of WGS area or coverage is derived from a MODIS consistent land surface parameters dataset (Lawrence and Chase, 2007; https://svn-ccsm-inputdata.cgd.ucar.edu/trunk/inputdata/lnd/clm2/mappingdata/grids/).",
            "ontology_conformed": true,
