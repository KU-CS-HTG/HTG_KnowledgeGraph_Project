        {
            "source_entity_instance": "Flood",
            "source_entity_type": "Natural_Hazard",
            "relation": "IS_OF_TYPE",
            "target_entity_instance": "Flood",
            "target_entity_type": "NaturalHazardType",
            "paragraph": "\u0412\u0438\u043a\u043e\u0440\u0438\u0441\u0442\u043e\u0432\u0443\u044e\u0447\u0438 \u0434\u0435\u0442\u0430\u043b\u044c\u043d\u0443 \u043f\u0430\u043d\u0435\u043b\u044c\u043d\u0443 \u0431\u0430\u0437\u0443 \u0434\u0430\u043d\u0438\u0445 \u0449\u043e\u0434\u0435\u043d\u043d\u0438\u0445 \u0432\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u044c \u0435\u043b\u0435\u043a\u0442\u0440\u043e\u0441\u0442\u0430\u043d\u0446\u0456\u0439 \u0442\u0430 \u043b\u043e\u043a\u0430\u043b\u044c\u043d\u0438\u0445 \u043f\u043e\u0433\u043e\u0434\u043d\u0438\u0445 \u0443\u043c\u043e\u0432 \u0437\u0430 \u043f\u0435\u0440\u0456\u043e\u0434 \u0437 2017 \u043f\u043e 2023 \u0440\u043e\u043a\u0438, \u043d\u0430\u0434\u0430\u043d\u043e \u043e\u0446\u0456\u043d\u043a\u0443 \u0432\u043f\u043b\u0438\u0432\u0443 \u0435\u043a\u0441\u0442\u0440\u0435\u043c\u0430\u043b\u044c\u043d\u0438\u0445 \u0442\u0435\u043c\u043f\u0435\u0440\u0430\u0442\u0443\u0440, \u043f\u043e\u0432\u0435\u043d\u0435\u0439 \u0456 \u043f\u043e\u0441\u0443\u0445 \u043d\u0430 \u0440\u0438\u0437\u0438\u043a\u0438 \u0432\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u044c. \u041e\u043a\u0440\u0435\u043c\u043e \u0440\u043e\u0437\u0433\u043b\u044f\u043d\u0443\u0442\u043e \u0432\u0456\u0434\u043c\u0456\u043d\u043d\u043e\u0441\u0442\u0456 \u043c\u0456\u0436 \u0432\u0438\u043c\u0443\u0448\u0435\u043d\u0438\u043c\u0438 \u0442\u0430 \u043f\u043b\u0430\u043d\u043e\u0432\u0438\u043c\u0438 \u0432\u0456\u0434\u043a\u043b\u044e\u0447\u0435\u043d\u043d\u044f\u043c\u0438, \u0449\u043e\u0431 \u043d\u0430\u0434\u0430\u0442\u0438 \u0432\u0438\u0437\u043d\u0430\u0447\u0435\u043d\u043d\u044f, \u044f\u043a \u0441\u0430\u043c\u043e \u043e\u043f\u0435\u0440\u0430\u0442\u043e\u0440\u0438 \u0440\u0435\u0430\u0433\u0443\u044e\u0442\u044c \u0430\u0431\u043e \u043f\u0435\u0440\u0435\u0434\u0431\u0430\u0447\u0430\u044e\u0442\u044c \u043f\u043e\u0433\u043e\u0434\u043d\u0456 \u0441\u0442\u0440\u0435\u0441\u0438.",
            "ontology_conformed": true,
            "evidence_validated": true,
