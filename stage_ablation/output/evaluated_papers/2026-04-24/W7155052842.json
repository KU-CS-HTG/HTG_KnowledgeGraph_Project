            "paragraph": "\u800c\u5728\u79ef\u96ea\u4e30\u6c9b\u5e74\u4efd,\u5feb\u901f\u5347\u6e29\u53e0\u52a0\u201c\u96ea\u9762\u96e8\u201d\u8fc7\u7a0b\u7684\u589e\u5f3a[21],\u5219\u53ef\u80fd\u5f15\u53d1\u6781\u5f3a\u7684\u878d\u96ea\u6d2a\u6c34,\u5f62\u6210\u201c\u66f4\u65e9\u3001\u66f4\u9661\u3001\u66f4\u77ed\u201d\u7684\u6625\u6c5b\u7279\u5f81,\u6781\u6613\u5f15\u53d1\u5c40\u5730\u6d2a\u6c34\u548c\u6ce5\u77f3\u6d41,\u8fd9\u79cd\u4ece\u201c\u53ef\u9884\u6d4b\u7684\u201d\u5b63\u8282\u6027\u6c34\u6e90\u5411\u201c\u4e0d\u7a33\u5b9a\u7684\u201d\u8109\u51b2\u5f0f\u6c34\u6e90\u7684\u8f6c\u53d8,\u4e25\u91cd\u6311\u6218\u4e86\u4e2d\u4e9a\u5730\u533a\u4f9d\u8d56\u201c\u6625\u6c34\u590f\u7528\u201d\u6a21\u5f0f\u7684\u519c\u4e1a\u704c\u6e89\u7cfb\u7edf\u548c\u6c34\u8d44\u6e90\u7ba1\u7406\u7b56\u7565",
