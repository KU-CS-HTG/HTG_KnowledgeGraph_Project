            "paragraph": "\u4e2d\u4e9a\u5730\u533a(\u4e3b\u8981\u5305\u62ec\u54c8\u8428\u514b\u65af\u5766\u3001\u5409\u5c14\u5409\u65af\u65af\u5766\u3001\u5854\u5409\u514b\u65af\u5766\u3001\u571f\u5e93\u66fc\u65af\u5766\u548c\u4e4c\u5179\u522b\u514b\u65af\u5766)\u6df1\u5c45\u5185\u9646,\u8fdc\u79bb\u6d77\u6d0b,\u6c14\u5019\u5e72\u65f1,\u751f\u6001\u7cfb\u7edf\u8106\u5f31,\u662f\u5bf9\u5168\u7403\u6c14\u5019\u53d8\u5316\u54cd\u5e94\u6700\u4e3a\u654f\u611f\u7684\u533a\u57df\u4e4b\u4e00",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "ERA5",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "\u6b27\u6d32\u4e2d\u671f\u5929\u6c14\u9884\u62a5\u4e2d\u5fc3",
            "target_entity_type": "Institute",
            "paragraph": "\u6839\u636e\u6b27\u6d32\u4e2d\u671f\u5929\u6c14\u9884\u62a5\u4e2d\u5fc3(ECMWF)\u7684ERA5\u518d\u5206\u6790\u6570\u636e,1981~2020\u5e74\u95f4,\u4e2d\u4e9a\u5730\u533a\u5e74\u5e73\u5747\u6c14\u6e29\u4e0a\u5347\u901f\u7387\u7ea6\u4e3a0.35\u2103/10\u5e74,\u800c\u6625\u5b63\u5e73\u5747\u6c14\u6e29\u7684\u4e0a\u5347\u901f\u7387\u9ad8\u8fbe0.45\u2103/10\u5e74\u4ee5\u4e0a,\u90e8\u5206\u5730\u533a\u751a\u81f3\u8d85\u8fc70.5\u2103/10\u5e74[4,5].",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CRU TS",
            "source_entity_type": "Source",
            "relation": "PRODUCED_BY_INSTITUTE",
            "target_entity_instance": "\u82f1\u56fd\u56fd\u5bb6\u5927\u6c14\u79d1\u5b66\u4e2d\u5fc3",
            "target_entity_type": "Institute",
            "paragraph": "\u82f1\u56fd\u56fd\u5bb6\u5927\u6c14\u79d1\u5b66\u4e2d\u5fc3(Climatic Research Unit, CRU)\u53d1\u5e03\u7684CRU TS\u6e29\u5ea6\u6570\u636e\u96c6\u56e0\u5176\u957f\u671f\u8fde\u7eed\u6027\u548c\u4e00\u81f4\u6027,\u88ab\u5e7f\u6cdb\u7528\u4e8e\u5168\u7403\u53ca\u533a\u57df\u6c14\u5019\u53d8\u5316\u7814\u7a76.",
