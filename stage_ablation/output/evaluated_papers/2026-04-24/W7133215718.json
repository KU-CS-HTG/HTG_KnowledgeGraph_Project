            "paragraph": "\u0917\u0941\u0930\u094d\u0926\u0940\u092a \u0938\u093f\u0902\u0939 Singh (1974) \u0915\u0947 \u092a\u0930\u093e\u0917 \u0935\u093f\u0936\u094d\u0932\u0947\u0937\u0923 (Pollen analysis) \u0938\u0947 \u092a\u0924\u093e \u091a\u0932\u0924\u093e \u0939\u0948 \u0915\u093f \u0930\u093e\u091c\u0938\u094d\u0925\u093e\u0928 \u0914\u0930 \u092a\u0902\u091c\u093e\u092c \u0915\u0947 \u0915\u094d\u0937\u0947\u0924\u094d\u0930\u094b\u0902 \u092e\u0947\u0902 \u0906\u0930\u094d\u0926\u094d\u0930 \u0935\u0928\u0938\u094d\u092a\u0924\u093f\u092f\u094b\u0902 \u0915\u0940 \u091c\u0917\u0939 \u0930\u0947\u0917\u093f\u0938\u094d\u0924\u093e\u0928\u0940 \u091d\u093e\u0921\u093c\u093f\u092f\u094b\u0902 \u0928\u0947 \u0932\u0947 \u0932\u0940 \u0925\u0940\u0964 \u0907\u0938 \u092a\u093e\u0930\u093f\u0938\u094d\u0925\u093f\u0924\u093f\u0915\u0940\u092f \u092c\u0926\u0932\u093e\u0935 \u0928\u0947 \u092a\u0936\u0941\u092a\u093e\u0932\u0928 \u0915\u094b \u092d\u0940 \u092a\u094d\u0930\u092d\u093e\u0935\u093f\u0924 \u0915\u093f\u092f\u093e, \u091c\u093f\u0938\u0938\u0947 \u0938\u092d\u094d\u092f\u0924\u093e \u0915\u0947 \u0906\u0930\u094d\u0925\u093f\u0915 \u0906\u0927\u093e\u0930 '\u0915\u0943\u0937\u093f \u0914\u0930 \u092a\u0936\u0941\u092a\u093e\u0932\u0928' \u0926\u094b\u0928\u094b\u0902 \u0939\u0940 \u0927\u094d\u0935\u0938\u094d\u0924 \u0939\u094b \u0917\u090f\u0964",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Flood",
