            "eval": true
        },
        {
            "source_entity_instance": "Pacific Meridional Overturning Circulation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Pacific",
            "target_entity_type": "No_Country_Region",
            "paragraph": "With both increases in CO2, the changes in ocean heat transport are largely due to the Pacific associated with a robust Pacific Meridional Overturning Circulation, similar to some other simulations of the Neogene (e.g., Burls et al., 2017).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "AMOC",
            "source_entity_type": "Ocean_Circulation",
