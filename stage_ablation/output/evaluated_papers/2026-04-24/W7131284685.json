        },
        {
            "source_entity_instance": "Community Earth System Model version 1.2 (iCESM1.2)",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "equilibrium climate sensitivity",
            "target_entity_type": "Metric",
            "paragraph": "The doubling of CO2 results in an equilibrium climate sensitivity of 3.9\u00b0C from 1x to 2x PI CO2 and 4.1\u00b0C from 2x to 4x PI CO2 (Fig. 1d).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Community Atmosphere Model version 5 with the Modal Aerosol Model (CAM5-MAM3)",
            "source_entity_type": "SourceComponent",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "global mean annual surface temperatures (MAT)",
            "target_entity_type": "Variable",
            "paragraph": "Our results show global mean annual surface temperatures (MAT) of 18.4, 22.3, 26.4\u00b0C in the MCO1x, MCO2x, and MCO4x cases, respectively (Table 1).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Community Atmosphere Model version 5 with the Modal Aerosol Model (CAM5-MAM3)",
            "source_entity_type": "SourceComponent",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "precipitation",
            "target_entity_type": "Variable",
            "paragraph": "In the MCO1x experiment, precipitation averages 3.1 mm/day and 1.8 mm/day over the NH and SH high-latitudes, respectively (Fig.1).",
            "ontology_conformed": true,
            "evidence_validated": true,
