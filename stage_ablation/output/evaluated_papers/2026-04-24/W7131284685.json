            "target_entity_instance": "equilibrium",
            "target_entity_type": "SimulationType",
            "paragraph": "The MCO2x case was integrated for 4,050 years to attain an equilibrium climate state with a net top of atmosphere (TOA) energy imbalance of -0.04 W/m\u00b2.",
            "ontology_conformed": true,
            "evidence_validated": true,
