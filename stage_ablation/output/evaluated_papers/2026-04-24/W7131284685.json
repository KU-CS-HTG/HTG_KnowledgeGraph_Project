        {
            "source_entity_instance": "Community Earth System Model version 1.2 (iCESM1.2)",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "RMSE",
            "target_entity_type": "Metric",
            "paragraph": "Table 2. RMSE for comparison of MCO simulations against proxy reconstructions for annual, summer (JJA in NH and DJF in SH), and winter (DJF in NH and JJA in SH). Annual precipitation is calculated in mm/year and seasonal precipitation in mm/day.",
            "ontology_conformed": true,
            "evidence_validated": true,
