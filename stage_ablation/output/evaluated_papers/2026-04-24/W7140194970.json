            "target_entity_instance": "adaptive rooting depth",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "The model represents physical processes relevant to high latitudes, such as snow dynamics, soil freeze-thaw, and adaptive rooting depth to layers that are non-frozen (Lacroix et al., 2022).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
