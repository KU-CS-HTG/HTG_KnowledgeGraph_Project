        },
        {
            "source_entity_instance": "Garrett-Grasselli economic framework",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "spatially aggregated global economy",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "To develop an IAM that incorporates inflation, the first simplification we employ is to aggregate the global economy spatially as a whole, not as a collection of discrete nations and sectors. Such details multiply the necessary assumptions about how economic elements interact, increasing the range of possible climate change scenarios and interpretations (National Academies of Sciences and Medicine, 2024).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Garrett-Grasselli economic framework",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "temporally aggregated global economy",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "The second simplification we make is to aggregate the global economy temporally to include all of history. This offers both consistency with spatial aggregation and addresses a concern that physical capital K does not does not include all that is potentially affected by climate change.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
