            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Logistic Growth Phenology model",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Vegetation in JSBACH is represented by plant functional types (PFTs). In this study, urban vegetation was described using two PFTs, C3 grasses and broadleaved deciduous trees, with modified parameters to represent the specific vegetation types such as lawn, mesic meadow, dry meadow, forest, and park. Phenology is simulated using the Logistic Growth Phenology model (B\u00f6ttcher et al. 2016), which distinguishes five phenology types: evergreen, summergreen, raingreen, grasses, and crops.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
