        {
            "source_entity_instance": "DSSAT",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "CROPGRO-Soybean",
            "target_entity_type": "SourceComponent",
            "paragraph": "Building on these advances, many regional-scale studies have demonstrated that the CROPGRO-Soybean module reproduces key developmental stages, including flowering onset, pod initiation and physiological maturity when genetic coefficients are calibrated using observational datasets (Ritchie, 1998; Fernandes et al., 2022).",
            "ontology_conformed": true,
