        {
            "source_entity_instance": "Regional Ocean Modelling System (ROMS)",
            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "40 vertical layers",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "Hydrodynamic simulation was performed on a regional grid with 40 vertical layers and encompasses the region between 25.3\u00b0S and 28.9\u00b0S in latitude and 45.0\u00b0W and 49.0\u00b0W in longitude, i.e., including the D03 domain of the WRF model.",
            "ontology_conformed": true,
