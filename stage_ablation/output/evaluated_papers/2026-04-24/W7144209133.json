            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "krill growth equations",
            "target_entity_type": "SourceComponent",
            "paragraph": "The growth equations for krill were initially plotted based on information gathered from empirical literature. With these equations, we explored the consequences of altering temperature and plankton densities, as predicted by polar climate change.",
            "ontology_conformed": true,
