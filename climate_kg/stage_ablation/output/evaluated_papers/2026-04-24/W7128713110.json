            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CA-Markov",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "Kappa statistic",
            "target_entity_type": "Metric",
            "paragraph": "To assess the reliability of the projection model, a standard hindcast validation was performed. The model was validated by simulating the 2024 LULC using the 2014 map as a baseline. The simulated 2024 map was then compared to the actual 2024 classified map using a confusion matrix. This validation yielded a Kappa statistic of 0.78, indicating substantial agreement between the simulated and actual LULC (Vanbelle et al., 2024).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
