        {
            "source_entity_instance": "GIS-based hydrological model",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "Streamflow elasticity",
            "target_entity_type": "Metric",
            "paragraph": "Streamflow elasticity is a simple and widely used metric to estimate the sensitivity of streamflow to precipitation changes, often serving as an alternative to rainfall-runoff models in climate impact assessments. Recent global-scale studies emphasize that streamflow elasticity is not only influenced by climatic inputs but also varies significantly with catchment characteristics such as aridity, forest cover, and baseflow contributions (Zhang et al. 2022). To better understand the sensitivity of basin hydrological response to future climate variability, an elasticity analysis was conducted using projected precipitation and corresponding flood discharge values.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": false
