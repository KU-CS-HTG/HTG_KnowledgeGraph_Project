        },
        {
            "source_entity_instance": "NEMO ocean-sea-ice model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "three-equation thermodynamic system",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "In all simulations, sub-shelf melt is calculated using the widely-used three-equation thermodynamic system that accounts for the heat and salt balances at the ice-ocean interface, and the pressure and temperature dependence of freezing temperature (Holland and Jenkins, 1999; Asay-Davis et al., 2016; Mathiot et al., 2017).",
            "ontology_conformed": false,
            "evidence_validated": false,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "overturning circulation",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Southern Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The mass loss of the Antarctic ice sheet has led on average to a freshwater input of 2680 Gt yr\u22121 to the Southern Ocean over the period 1997 to 2021 (Davison et al., 2023). 40 % of this freshwater (1080 Gt yr\u22121) enters the ocean at a few hundred meters depth, in the form of meltwater originating at the base of the ice shelves, the floating margins of the ice sheet. This meltwater has local and global implications for the ocean, driving overturning circulation, affecting low-latitude primary productivity and influencing the oceanic carbon sink (Gruber et al., 2019; DeVries, 2014), as well as being a driver of mass loss from the grounded Antarctic Ice Sheet (Rignot, 2002; Pritchard et al., 2012).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
