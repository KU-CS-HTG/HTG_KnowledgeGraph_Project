            "relation": "IS_OF_TYPE",
            "target_entity_instance": "Drought",
            "target_entity_type": "NaturalHazardType",
            "paragraph": "\u6781\u7aef\u5929\u6c14\u4e8b\u4ef6\u9891\u7387\u548c\u5f3a\u5ea6\u589e\u52a0\u663e\u8457\u6270\u52a8\u4e86\u533a\u57df\u7cae\u98df\u751f\u4ea7\u7684\u7a33\u5b9a\u6027\u3002\u897f\u5317\u5730\u533a\u7684\u6c14\u8c61\u707e\u5bb3\u5448\u73b0\u201c\u79cd\u7c7b\u591a\u3001\u8303\u56f4\u5e7f\u3001\u7a81\u53d1\u6027\u5f3a\u201d\u7684\u7279\u70b9[5]\u3002\u5e72\u65f1\u3001\u5e72\u70ed\u98ce\u3001\u65f1\u6d9d\u6025\u8f6c\u3001\u65e9\u665a\u971c\u51bb\u3001\u82b1\u671f\u70ed\u5bb3\u3001\u51b0\u96f9\u3001\u98ce\u5bb3\u4e0e\u6c99\u5c18\u5929\u6c14\u5171\u540c\u6784\u6210\u5f71\u54cd\u897f\u5317\u5730\u533a\u7cae\u98df\u7a33\u4ea7\u7684\u4e3b\u8981\u6c14\u8c61\u98ce\u9669\u94fe\u6761\u3002\u5e72\u65f1\u662f\u5f71\u54cd\u9762\u6700\u5e7f\u7684\u707e\u5bb3\u7c7b\u578b\u4e4b\u4e00, \u867d\u7136\u964d\u6c34\u603b\u91cf\u5728\u90e8\u5206\u533a\u57df\u6709\u6240\u589e\u52a0, \u4f46\u964d\u6c34\u53d8\u7387\u7684\u589e\u5927\u5bfc\u81f4\u4e86\u9891\u7e41\u7684\u5b63\u8282\u6027\u5e72\u65f1[6]\u3002",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
