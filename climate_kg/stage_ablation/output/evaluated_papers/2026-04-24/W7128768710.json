            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "PolyU2025 SLA",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "acceleration",
            "target_entity_type": "Metric",
