            "relation": "HAS_METRIC",
            "target_entity_instance": "Nash-Sutcliffe Efficiency (NSE)",
            "target_entity_type": "Metric",
            "paragraph": "While rainfall is inherently stochastic and challenging to model at a daily scale, the model achieved a Nash-Sutcliffe Efficiency (NSE) [24] of 0.66, indicating a \u201cgood\u201d fit according to standard hydrological modeling benchmarks.",
            "ontology_conformed": true,
