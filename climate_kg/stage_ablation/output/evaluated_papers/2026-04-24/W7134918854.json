            "relation": "HAS_METRIC",
            "target_entity_instance": "RMSE",
            "target_entity_type": "Metric",
            "paragraph": "In the validation phase (2001\u20132005), the model demonstrated strong transferability. Although a slight increase was observed with the RMSE rising from 0.727 to 0.821 and the MAE from 0.55 to 0.60, the NSE remained robust at 0.605.",
            "ontology_conformed": true,
            "evidence_validated": true,
