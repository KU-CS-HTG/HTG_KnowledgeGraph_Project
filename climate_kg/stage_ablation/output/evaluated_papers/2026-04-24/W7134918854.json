            "target_entity_instance": "Durbin-Watson (DW) statistic",
            "target_entity_type": "Metric",
            "paragraph": "The Durbin-Watson (DW) statistic [25] of 2.092 confirms the absence of significant autocorrelation in the residuals, validating the independence of the error terms.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
