            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CaMa-Flood",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "floodplain diffusion",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Within each unit catchment, explicit storage modeling is applied, with flow routing based on river hydrodynamic routing methods for subgrid topography; water levels are calculated from storage volumes and cross-sectional geometry, discharge from water surface gradients and channel conveyance, and inundation initiated when levels exceed bankfull capacity, allowing lateral floodwater spreading via floodplain diffusion.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CaMa-Flood",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "Dam Module",
            "target_entity_type": "SourceComponent",
            "paragraph": "To incorporate reservoir operations into CaMa-Flood, unit catchments that contain reservoir extents are identified, enabling the direct substitution of the naturalized river discharge at those outlets with outflows calculated using predefined operational rules. This study adopts the operational scheme of Hanazaki et al. (2022), which has demonstrated strong performance in continental-scale hydrodynamic simulations. This scheme divides total reservoir storage capacity into three operational zones.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CaMa-Flood",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "kinematic wave equations",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "To address bathymetry simulation artifacts that generate upstream backwater effects (Shin et al., 2019), discharges in pre-dam grids are recomputed using kinematic wave equations, producing more realistic inflow-outflow dynamics within this physically consistent framework.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
