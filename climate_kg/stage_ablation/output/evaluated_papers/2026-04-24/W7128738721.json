        {
            "source_entity_instance": "CoCiP",
            "source_entity_type": "SourceComponent",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "energy forcing of contrails",
            "target_entity_type": "Variable",
            "paragraph": "The energy forcing of contrails, EF Aic, is calculated using CoCiP, a Lagrangian model that simulates the formation, evolution, and radiative impact of contrail cirrus on flight segments based on aircraft emissions and atmospheric conditions (Schumann, 2012). It accounts for processes such as ice crystal formation, sedimentation, dispersion, and radiative transfer, enabling the estimation of contrail energy forcing along a flight trajectory.",
            "ontology_conformed": true,
