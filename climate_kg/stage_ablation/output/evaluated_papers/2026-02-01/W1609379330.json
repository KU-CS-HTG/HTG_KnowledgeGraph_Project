            "target_entity_instance": "dissolved Ca",
            "target_entity_type": "Variable",
            "paragraph": "Samples from total digestion or rapid filtration were analysed for dissolved Al, Ca, Fe and other cations using a Varian Vista ICP-OES at the University of Cambridge.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "FIA-8HQ",
            "source_entity_type": "Instrument",
            "relation": "MEASURES_VARIABLE",
            "target_entity_instance": "dissolved Fe",
            "target_entity_type": "Variable",
            "paragraph": "Each aliquot of seawater was allowed to leach the dust momentarily, vacuum was applied and then the liquid was pulled through and acidified to pH 1.6 with 120 \u00b5l of conc. ultrapure HCl. Samples were left acidified for 2 weeks before being analysed for dissolved Fe by FIA-8HQ, following published techniques45.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Berkner Island ice core",
