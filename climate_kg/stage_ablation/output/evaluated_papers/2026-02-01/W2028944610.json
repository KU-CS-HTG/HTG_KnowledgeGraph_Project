        {
            "source_entity_instance": "Atmospheric blocking",
            "source_entity_type": "Weather_Event",
            "relation": "IMPACTED_REGION",
            "target_entity_instance": "Northern Europe",
            "target_entity_type": "No_Country_Region",
            "paragraph": "In particular, it is shown that the northwest Atlantic (central North Pacific) exhibits significantly higher blocking frequencies during the negative NAO (PNA) phase (>100% increase compared to the local climatological values that translates to ~10 days more blocking per season). The corresponding positive index phase is characterised by the near absence of blocking in these same regions. Moreover, the two-dimensional representation of blocking composites provides detailed information on the precise location and frequency of blocks and thereby both refines and extends extant studies that have focussed predominantly on the longitudinal blocking distribution (e.g. Pavan et al. 2000; Shabbar et al. 2001). In harmony with the results presented herein other recent two-dimensional blocking representations of NAO-only composites (Barriopedro et al. 2006; Scherrer et al. 2006) also point to significantly higher blocking frequencies over the western/ central North Atlantic during the negative NAO phase and over Northern Europe during the positive phase.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "El Nino / La Nina",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "equatorial SST",
            "target_entity_type": "No_Country_Region",
            "paragraph": "In this context it is pertinent to note that PNA variability has itself been linked to the equatorial SST and strong El Nino / La Nina events (Horel and Wallace 1981).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
