        {
            "source_entity_instance": "Tropical Instability Waves",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "eastern tropical Pacific Ocean",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Tropical instability waves (TIWs) in the eastern tropical Pacific Ocean, caused by mixed barotropic/baroclinic instability, are a highly visible sign of ocean variability in observations (e.g., Legeckis, 1977).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Hawaiian Lee Countercurrent",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Hawaiian Islands",
            "target_entity_type": "No_Country_Region",
            "paragraph": "Another illustration of the incremental role that ocean and atmosphere mesh size can play on the coupled climate is seen in the simulation of the Hawaiian Lee Countercurrent (HLCC), which is described in detail by Sasaki and Nonaka (2006). Simply stated, a wind stress curl caused by the trade winds interacting with the Hawaiian Islands induces a circulation in the ocean which drives a eastward countercurrent at about 20N extending from west of 160E to the Hawaiian Islands.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Antarctic Circumpolar Current",
            "source_entity_type": "Ocean_Circulation",
            "relation": "OBSERVED_IN_REGION",
            "target_entity_instance": "Antarctic",
            "target_entity_type": "No_Country_Region",
            "paragraph": "There are many examples of ocean processes that are important for climate simulation and which require some minimal mesh size for a believable simulation (examples include dense flow through narrow gaps, boundary currents, deep water formation, eddy processes involved in Tropical Instability Waves, Agulhas rings and the Antarctic Circumpolar Current).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
