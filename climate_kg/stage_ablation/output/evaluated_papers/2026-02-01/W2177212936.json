            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Siberia",
            "target_entity_type": "No_Country_Region",
            "paragraph": "The time series of 20th century Siberian warm season (May to October) precipitation (SWP) shows variations over decadal timescales, including a wetting trend since the 1970s. Here, it is shown that the Atlantic multidecadal variability (AMV) can be implicated as a remote driver of the decadal-scale variations in SWP.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "Atlantic multidecadal variability",
            "source_entity_type": "Teleconnection",
            "relation": "INFLUENCES_REGION",
            "target_entity_instance": "Eurasian continent",
            "target_entity_type": "Continent",
            "paragraph": "The results suggest that North Atlantic sea surface temperature (SST) warming associated with the positive AMV phase can excite an eastward propagating wave train response across the entire Eurasian continent, which includes an east-west dipole structure over Siberia.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
