        {
            "source_entity_instance": "CASA' model",
            "source_entity_type": "Source",
            "relation": "INHERITED_FROM",
            "target_entity_instance": "CASA model",
            "target_entity_type": "Source",
            "paragraph": "The model CASA' was developed from the CASA model (Randerson et al., 1997) and has been used in studying the carbon-climate feedback globally (Fung et al., 2005).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
