        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "CASA' model",
            "target_entity_type": "SourceComponent",
            "paragraph": "To overcome the data limitation, we will use a well calibrated carbon cycle model (CASA') as our carbon cycle submodel and modeling framework and make use of observed coupling among all three cycles to constrain the nutrient (N and P) pools and fluxes.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "Nitrogen cycle model (Parton et al., 1987; Wang et al., 2007)",
            "target_entity_type": "SourceComponent",
            "paragraph": "The nitrogen cycle is based on the model developed by Parton et al. (1987) and Wang et al. (2007). Similar to the C cycle, the change in N in each pool is governed by a differential equation (see Appendix C).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "\"holes-in-the-pipe\" N loss scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "In our model gaseous N loss is assumed to be proportional to net N mineralization based on the \"holes-in-the-pipe\" idea (Firestone and Davidson, 1989) and the rate of leaching loss is proportional to the soil inorganic N pool size.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "Phosphorus cycle model (Wang et al., 2007; Houlton et al., 2008)",
            "target_entity_type": "SourceComponent",
            "paragraph": "The phosphorus cycle is based on the model of Wang et al. (2007) and Houlton et al. (2008). The differential equations used to describe the rate of change of each pool are presented in Appendix D.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "biochemical P mineralization scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "Phosphorus in the slow and passive soil pools can also be mineralized biochemically (McGill and Cole, 1981). Therefore the N:P ratios of the slow and passive pools will increase until a steady state is reached when the P fluxes into those two pools through P immobilization (biologically only) are equal to the rates of P being mineralized (both biologically and biochemically) from those pools. Biochemical mineralization is modeled as a function of soil organic P, the N costs of P uptake and phosphatase production, and maximal specific biochemical P mineralization rate (see Wang et al., 2007; Houlton et al., 2008).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Langmuir equation for P sorption",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "We assumed that the labile P pool is equilibrated with the sorbed P within days. The relationship between the amount of labile P and sorbed P is described using the Langmuir equation (Barrow, 1978; Lloyd et al., 2001; Wang et al., 2007).",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CCAM",
            "source_entity_type": "Source",
            "relation": "HAS_SOURCE_COMPONENT",
            "target_entity_instance": "CABLE",
            "target_entity_type": "SourceComponent",
            "paragraph": "The daily meteorological forcing was generated using the CSIRO Conformal Cubic Atmosphere Model, CCAM, (McGregor and Dix, 2008) with the CSIRO Atmosphere and Biosphere Land Exchange (CABLE) land surface scheme (Wang and Leuning, 1998; Kowalczyk et al., 2006) at a spatial resolution of approximately 220 km globally.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "CASACNP model",
            "source_entity_type": "Source",
            "relation": "HAS_SIMULATION_TYPE",
            "target_entity_instance": "steady-state",
            "target_entity_type": "SimulationType",
            "paragraph": "By reusing the daily forcings from 1990 to 1997, we ran the model to steady state. Steady state is considered to have been reached when the relative changes in total pool sizes of C, N or P per land point are less than 0.001% per year. All results reported here are for steady state in the 1990's only.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        }
    ],
