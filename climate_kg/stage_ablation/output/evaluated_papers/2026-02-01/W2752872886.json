            "target_entity_type": "Metric",
            "paragraph": "Reasons for caution include the attribute that the GFDL CM3 model has unusually large GMST variability in its pre-industrial control run as well as a 2 \u00d7 CO2 climate sensitivity towards the upper range of the CMIP5 ensemble range49.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
