            "target_entity_type": "Variable",
            "paragraph": "To test further the hypothesis that the south-to-north causal order is generated by anthropogenic emissions of greenhouse gases and tropospheric sulphates, we analyse temperature data generated by a coupled atmosphere\u2013ocean general circulation model.",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
