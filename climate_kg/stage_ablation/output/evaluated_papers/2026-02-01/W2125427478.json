        },
        {
            "source_entity_instance": "flooding",
            "source_entity_type": "Natural_Hazard",
            "relation": "IS_OF_TYPE",
            "target_entity_instance": "Flood",
            "target_entity_type": "NaturalHazardType",
            "paragraph": "An event in early January 2012 exposed the vulnerability of the northern parts of The Netherlands to flooding. During a few consecutive days 20\u201330 mm of rain per day fell, due to passing of synoptic pressure systems. The sluicing capacity from the inland waterways to the North Sea is 10 mm per day, but strong north- westerly winds at the end of the period of high rainfall created a surge that prevented sluicing at low tide (Figure B1). This led authorities to order evacuation of the region and there was a call for extra measures to protect against future events like these. The return periods of the precipitation event and of the winds were very modest (3\u20137 years). The flood is an example of a compound event where neither precipitation nor surge were extreme, but the two in combination had a large hydrological impact for this region.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "thermohaline circulation",
            "source_entity_type": "Ocean_Circulation",
