            "source_entity_instance": "ECHAM5-HAM",
            "source_entity_type": "Source",
            "relation": "USES_PHYSICAL_SCHEME",
            "target_entity_instance": "Joos et al. (2008) orographic gravity wave scheme",
            "target_entity_type": "PhysicalScheme",
            "paragraph": "In order to account for orographically induced cirrus clouds, which form in the lee of mountains, the formulation of the vertical velocity has been extended. We assume that, following Joos et al. (2008), the turbulent component is dominated by the vertical velocity of a gravity wave wgw in the case of orography",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
