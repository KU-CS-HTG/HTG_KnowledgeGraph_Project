            "target_entity_type": "PhysicalScheme",
            "paragraph": "The diagnostic cloud cover scheme by Sundqvist et al. (1989) is used. It is based on the grid-mean relative humidity and assumes that a grid box is partly covered by clouds when a critical relative humidity is exceeded and is totally covered when saturation is reached.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
