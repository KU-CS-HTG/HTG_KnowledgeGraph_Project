            "relation": "HAS_METRIC",
            "target_entity_instance": "net change in the radiation budget",
            "target_entity_type": "Metric",
            "paragraph": "The net change in the radiation budget is -0.94 W m\u22122, implying that both heterogeneous nucleation on dust and pre-existing ice have the potential to modulate cirrus properties in climate simulations and thus should be considered in future studies.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
        {
            "source_entity_instance": "Saharan dust outbreaks",
