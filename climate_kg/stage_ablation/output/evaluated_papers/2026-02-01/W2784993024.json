            "target_entity_instance": "atmosphere-only simulation",
            "target_entity_type": "SimulationType",
            "paragraph": "We assess simulated OSA using an atmosphere-only simulation with prescribed radiative forcing (greenhouse gases, aerosols, land-cover change) and fixed sea surface temperature as recommended by CMIP5 (Taylor et al., 2012). LMDZ has been integrated from 1979 up to 2012 under this protocol.",
            "ontology_conformed": true,
            "evidence_validated": true,
