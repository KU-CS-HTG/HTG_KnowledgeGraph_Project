            "source_entity_instance": "CROCUS",
            "source_entity_type": "Source",
            "relation": "PRODUCES_VARIABLE",
            "target_entity_instance": "snow density",
            "target_entity_type": "Variable",
            "paragraph": "To calculate its [the snow-pack's] temperature, density, and liquid-water content profiles, the snow-pack is divided into layers",
            "ontology_conformed": false,
            "evidence_validated": true,
            "valid": false,
            "eval": true
        },
