            "source_entity_type": "Instrument",
            "relation": "MOUNTED_ON",
            "target_entity_instance": "ship",
            "target_entity_type": "Platform",
            "paragraph": "Because few Argo floats can be recovered for sensor recalibration, the final quality of Argo data will depend on the existence and availability of high-quality shipboard CTD data. Shipboard CTD transects are useful not only to detect systematic errors in Argo float data but also in joint analyses with Argo data for better description of interannual to multidecadal signals in the ocean.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
