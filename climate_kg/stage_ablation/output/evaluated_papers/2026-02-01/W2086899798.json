            "relation": "HAS_METRIC",
            "target_entity_instance": "underestimated interannual variability of the UV-B radiation",
            "target_entity_type": "Metric",
            "paragraph": "The model underestimates the interannual variability of the UV-B radiation compared to the observations, except for Sapporo.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
