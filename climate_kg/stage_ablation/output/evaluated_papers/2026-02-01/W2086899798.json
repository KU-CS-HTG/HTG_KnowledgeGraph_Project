            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC-ESM-CHEM",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "bias in shortwave cloud forcing",
            "target_entity_type": "Metric",
            "paragraph": "The model underestimates shortwave cloud forcing over the areas of Honshu, Japan, which includes Tateno, the Philippines, Indonesia, and many parts of continental East Asia, which causes systematic overestimation of the simulated surface UV-B radiation. For Kagoshima, the overestimation of surface UV-B radiation is most obvious in June, when the model underestimates cloud forcing associated with the Baiu front. These model biases in cloud forcing may be related to the model's coarse horizontal resolution and widely affect the simulated surface UV-B radiation over Asia.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC-ESM-CHEM",
            "source_entity_type": "Source",
            "relation": "HAS_METRIC",
            "target_entity_instance": "bias in total column ozone",
            "target_entity_type": "Metric",
            "paragraph": "It should be noted that the model bias in total column ozone was generally positive over Asia, which partly compensated for the underestimation of cloud forcing.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
            "source_entity_instance": "MIROC-ESM-CHEM",
