            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "Arakawa-type conservation in the vertical diffusion",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "Yet another refinement of our upgraded Eta code is the enforcement of the Arakawa-type conservation in the vertical diffusion. This is done using the standard technique (e.g., Arakawa and Lamb 1977) of writing the advective form of a difference equation so that it is equivalent to its flux form.",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
