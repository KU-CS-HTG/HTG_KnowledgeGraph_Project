            "source_entity_type": "Source",
            "relation": "HAS_PHYSICAL_FEATURE",
            "target_entity_instance": "E-grid",
            "target_entity_type": "PhysicalFeature",
            "paragraph": "Forward-backward scheme is used for time differencing of the gravity-wave terms, modified so as to suppress separation of solutions on two C-subgrids of the model\u2019s E-grid (Mesinger 1974; Janjic 1979; Mesinger and Popovic 2010).",
            "ontology_conformed": true,
            "evidence_validated": true,
            "valid": true,
            "eval": true
        },
        {
